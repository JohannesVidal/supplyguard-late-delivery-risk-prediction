# Environment variables
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/

# OS files
.DS_Store
Thumbs.db

# Raw and intermediate data
data/raw/*
!data/raw/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/database/*
!data/database/.gitkeep

# Processed data can become large; keep folder but ignore files by default
data/processed/*
!data/processed/.gitkeep

# Models
models/*
!models/.gitkeep

# Private notes
_private/
supplyguard-private-notes/
PROJECT_LOG.md
CHAT_HANDOFF.md
TODO_PRIVATE.md
QUESTIONS_PRIVATE.md

# Credentials / secrets
*.key
*.pem
credentials.json
token.json

# Large dashboard temp/cache files
*.tmp
*.bak


# Streamlit deployment allowlist
!data/processed/modeling_dataset.csv
!data/processed/feature_dictionary.csv
!outputs/best_model_compressed.pkl
!outputs/test_predictions_with_risk_segments.csv
!streamlit_app/assets/SupplyGuard_Logo.png
!streamlit_app/assets/SupplyGuard_Logo_Cropped.png
!.streamlit/
!.streamlit/config.toml
!.env.example

# Keep deployment folders visible for selected files
!data/
!data/processed/
!outputs/
!streamlit_app/
!streamlit_app/assets/

# Do not track oversized uncompressed model artifact
outputs/best_model.pkl
